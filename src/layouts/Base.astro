---
import Arrow from '../components/Arrow.astro';
import { SITE, CATEGORIES, LOCALES, editorialUrl, otherLocale, type Locale } from '../lib/site';
import { OG_LOCALE, siteGraph } from '../lib/seo';
import { getCategoryUrl } from '../lib/news';
import { bultenYolu, gizlilikYolu, hakkimizdaYolu, karsiYol, konuDiziniYolu, seffaflikYolu, sozlukYolu, aramaYolu } from '../lib/yollar.mjs';
import BultenFormu from '../components/BultenFormu.astro';
import '../styles/global.css';
import '../styles/bulten.css';

type Hreflang = Locale | 'x-default';

interface Props {
  lang?: Locale;
  title?: string;
  /** <title> ve og:title'ı olduğu gibi kullanır (marka eki eklenmez). */
  documentTitle?: string;
  description?: string;
  canonicalPath?: string;
  langUrls?: Partial<Record<Locale, string>>;
  /** hreflang eşleri; verilmezse her iki dil + x-default (EN) üretilir. Boş nesne: hiç hreflang yok. */
  alternates?: Partial<Record<Hreflang, string>>;
  activeCategory?: string;
  type?: 'website' | 'article';
  image?: string;
  imageAlt?: string;
  /** Paylaşım görselinin boyutu; verilmezse varsayılan /og-default.png (1200×630). Haber kapakları 1200×675. */
  imageWidth?: number;
  imageHeight?: number;
  published?: Date;
  modified?: Date;
  section?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
}

const {
  lang = 'en',
  title,
  documentTitle,
  description: descriptionProp,
  canonicalPath = Astro.url.pathname,
  langUrls,
  alternates,
  activeCategory,
  type = 'website',
  image,
  imageAlt,
  imageWidth = 1200,
  imageHeight = 630,
  published,
  modified,
  section,
  noindex = false,
  schema = [],
} = Astro.props;

const ui = SITE.ui[lang];
const other = otherLocale(lang);
const fullTitle =
  documentTitle ??
  (title ? `${title} | ${SITE.displayName}` : `${SITE.displayName} — ${SITE.tagline[lang]}`);
const ogTitle = documentTitle ?? title ?? fullTitle;
const rawDescription = (descriptionProp ?? '').trim() || SITE.description[lang];
const description =
  rawDescription.length > 160 ? `${rawDescription.slice(0, 157).trimEnd()}…` : rawDescription;
const canonicalUrl = new URL(canonicalPath, SITE.url).href;
const ogImage = new URL(image || '/og-default.png', SITE.url).href;
const ogAlt = imageAlt ?? documentTitle ?? title ?? SITE.displayName;
const homeHref = `/${lang}/`;
const editorialHref = editorialUrl(lang);
const aboutHref = hakkimizdaYolu(lang);
const transparencyHref = seffaflikYolu(lang);
const searchHref = aramaYolu(lang);
const topicsHref = konuDiziniYolu(lang);
const glossaryHref = sozlukYolu(lang);
const bultenHref = bultenYolu(lang);
const gizlilikHref = gizlilikYolu(lang);
const robots = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': [...siteGraph(), ...schema] }).replace(/</g, '\\u003c');
const path = Astro.url.pathname;
const isHome = path === '/' || path === `/${lang}/`;

function resolveLangUrl(targetLang: Locale): string {
  if (langUrls && langUrls[targetLang]) {
    return langUrls[targetLang]!;
  }
  // Yol parçaları dile göre değişir (/tr/haber/… ↔ /en/news/…); bkz. src/lib/yollar.mjs.
  if (/^\/(tr|en)(\/|$)/.test(path)) return karsiYol(path, targetLang);
  return `/${targetLang}/`;
}

const hreflangMap: Partial<Record<Hreflang, string>> = alternates ?? {
  en: resolveLangUrl('en'),
  tr: resolveLangUrl('tr'),
  'x-default': resolveLangUrl('en'),
};
const hreflangs = (Object.entries(hreflangMap) as [Hreflang, string][]).map(([key, href]) => ({
  // Dil kodu bölgesiz (en/tr): içerik tek bir ülkeye değil, o dili okuyan herkese.
  hreflang: key,
  href: new URL(href, SITE.url).href,
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#16181D" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/signika-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/atkinson-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.displayName} (${lang.toUpperCase()})`}
      href={`/${lang}/rss.xml`}
    />
    {hreflangs.map((h) => <link rel="alternate" hreflang={h.hreflang} href={h.href} />)}
    <meta property="og:site_name" content={SITE.displayName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:locale:alternate" content={OG_LOCALE[other]} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogAlt} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {section && <meta property="article:section" content={section} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <script type="application/ld+json" is:inline set:html={jsonLd} />
    <!-- Cloudflare Web Analytics -->
    <script
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "600e704eb70f43cca248a5bb77c6e92c"}'></script>
    <!-- End Cloudflare Web Analytics -->
  </head>
  <body>
    <a class="skip-link" href="#main-content">{ui.skipToContent}</a>

    <header class="overhead">
      <div class="container overhead-inner">
        <a href={homeHref} class="wordmark" aria-label={`${SITE.displayName} — ${ui.home}`}>
          <span class="wordmark-name">JEN DUME</span>
          <span class="wordmark-motto">
            <span>{SITE.tagline[lang]}</span>
            <span class="wordmark-motto-other" lang={other}>{SITE.tagline[other]}</span>
          </span>
        </a>

        <nav class="overhead-links" aria-label="Primary">
          <a href={homeHref} aria-current={isHome ? 'page' : undefined}>
            {ui.home}<span class="link-other" lang={other}>{SITE.ui[other].home}</span>
          </a>
          <a href={topicsHref} aria-current={path.startsWith(topicsHref) ? 'page' : undefined}>
            {ui.topics}<span class="link-other" lang={other}>{SITE.ui[other].topics}</span>
          </a>
          <a href={glossaryHref} aria-current={path.startsWith(glossaryHref) ? 'page' : undefined}>
            {ui.glossary}<span class="link-other" lang={other}>{SITE.ui[other].glossary}</span>
          </a>
          <a href={aboutHref} aria-current={path === aboutHref ? 'page' : undefined}>
            {ui.about}<span class="link-other" lang={other}>{SITE.ui[other].about}</span>
          </a>
          <a href={searchHref} aria-current={path.startsWith(searchHref) ? 'page' : undefined}>
            {ui.search}<span class="link-other" lang={other}>{SITE.ui[other].search}</span>
          </a>
          <a href={`/${lang}/rss.xml`}>
            {ui.rss}<span class="link-other">{lang.toUpperCase()}</span>
          </a>
        </nav>

        <nav class="lang-switch" aria-label={ui.availableLangs}>
          {
            LOCALES.map((loc) => (
              <a
                href={resolveLangUrl(loc)}
                lang={loc}
                hreflang={loc}
                class:list={['lang-plate', { 'is-active': loc === lang }]}
                aria-current={loc === lang ? 'true' : undefined}
              >
                <span class="lang-code">{loc.toUpperCase()}</span>
                <span class="lang-name">{SITE.ui[loc].langName}</span>
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <nav class="gates" aria-label={ui.allCategories}>
      <ul class="container gates-row">
        {
          CATEGORIES.map((cat, i) => {
            const active = activeCategory === cat.slug;
            return (
              <li>
                <a
                  href={getCategoryUrl(lang, cat.slug)}
                  class:list={['gate', { 'is-active': active }]}
                  aria-current={active ? 'page' : undefined}
                >
                  <span class="code" aria-hidden="true">{i + 1}</span>
                  <span class="gate-names">
                    <span class="gate-primary">{cat.shortTitle[lang]}</span>
                    <span class="gate-secondary" lang={other}>{cat.shortTitle[other]}</span>
                  </span>
                  <Arrow dir={active ? 'down' : 'right'} class="gate-arrow" />
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <main id="main-content" class="main-content">
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <a href={homeHref} class="wordmark">
            <span class="wordmark-name">JEN DUME</span>
            <span class="wordmark-motto">
              <span>{SITE.tagline[lang]}</span>
              <span class="wordmark-motto-other" lang={other}>{SITE.tagline[other]}</span>
            </span>
          </a>
        </div>
        <ul class="footer-gates" aria-label={ui.allCategories}>
          {
            CATEGORIES.map((cat, i) => (
              <li>
                <a href={getCategoryUrl(lang, cat.slug)}>
                  <span class="code" aria-hidden="true">{i + 1}</span>
                  <span>
                    {cat.title[lang]}
                    <span class="link-other" lang={other}>{cat.title[other]}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        <ul class="footer-links">
          <li><a href={bultenHref}><span>{ui.newsletter}<span class="link-other" lang={other}>{SITE.ui[other].newsletter}</span></span></a></li>
          <li><a href={gizlilikHref}><span>{ui.privacy}<span class="link-other" lang={other}>{SITE.ui[other].privacy}</span></span></a></li>
          <li><a href={homeHref}><span>{ui.home}<span class="link-other" lang={other}>{SITE.ui[other].home}</span></span></a></li>
          <li><a href={topicsHref}><span>{ui.topics}<span class="link-other" lang={other}>{SITE.ui[other].topics}</span></span></a></li>
          <li><a href={glossaryHref}><span>{ui.glossary}<span class="link-other" lang={other}>{SITE.ui[other].glossary}</span></span></a></li>
          <li><a href={aboutHref}><span>{ui.about}<span class="link-other" lang={other}>{SITE.ui[other].about}</span></span></a></li>
          <li><a href={editorialHref}><span>{ui.editorialStandards}<span class="link-other" lang={other}>{SITE.ui[other].editorialStandards}</span></span></a></li>
          <li><a href={transparencyHref}><span>{ui.transparency}<span class="link-other" lang={other}>{SITE.ui[other].transparency}</span></span></a></li>
          <li><a href={`/${lang}/rss.xml`}><span>{ui.rss}<span class="link-other">{lang.toUpperCase()}</span></span></a></li>
          <li><a href="/en/" lang="en">English</a></li>
          <li><a href="/tr/" lang="tr">Türkçe</a></li>
        </ul>
      </div>
      <div class="container">
        <BultenFormu lang={lang} kimlik="altbilgi" />
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} {SITE.displayName}</span>
        <span>{SITE.tagline[lang]} · <span lang={other}>{SITE.tagline[other]}</span></span>
      </div>
    </footer>
  </body>
</html>
