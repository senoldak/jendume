---
// Abonelik formu: altbilgide ve haber sayfasının sonunda. Gönderim /api/bulten/abone (worker/index.ts).
// Gizli dil alanı sayfanın dilini taşır; tuzak alanı görünmez, klavyeyle gezilmez, otomatik doldurulmaz.
import { SITE, type Locale } from '../lib/site';
import { gizlilikYolu } from '../lib/yollar.mjs';

interface Props {
  lang: Locale;
  /** Aynı sayfada birden çok form olduğu için benzersiz kimlik öneki. */
  kimlik: string;
}

const { lang, kimlik } = Astro.props;
const ui = SITE.ui[lang];
---

<section class="bulten-formu" aria-labelledby={`${kimlik}-baslik`}>
  <h2 class="bulten-formu-baslik" id={`${kimlik}-baslik`}>{ui.bultenBaslik}</h2>
  <p class="bulten-formu-aciklama">{ui.bultenAciklama}</p>
  <form class="bulten-form" action="/api/bulten/abone" method="post">
    <input type="hidden" name="dil" value={lang} />
    <div class="bulten-satir">
      <label class="bulten-etiket" for={`${kimlik}-eposta`}>{ui.bultenEposta}</label>
      <input
        class="bulten-alan"
        id={`${kimlik}-eposta`}
        name="eposta"
        type="email"
        required
        autocomplete="email"
        inputmode="email"
        maxlength="254"
        spellcheck="false"
      />
      <button class="bulten-dugme" type="submit">{ui.bultenAbone}</button>
    </div>
    <div class="bulten-tuzak">
      <label for={`${kimlik}-web`}>{ui.bultenTuzak}</label>
      <input id={`${kimlik}-web`} name="web" type="text" tabindex="-1" autocomplete="off" />
    </div>
  </form>
  <p class="bulten-not">
    {ui.bultenNot} <a href={gizlilikYolu(lang)}>{ui.bultenGizlilikBaglanti}</a>
  </p>
</section>
