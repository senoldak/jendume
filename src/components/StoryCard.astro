---
import SignLine from './SignLine.astro';
import { getPostUrl, type NewsEntry } from '../lib/news';
import type { Locale } from '../lib/site';

interface Props {
  post: NewsEntry;
  lang: Locale;
}

const { post, lang } = Astro.props;
---

<article class="story">
  <h3 class="story-title">
    <a href={getPostUrl(lang, post.id)}>{post.data.title}</a>
  </h3>
  <SignLine post={post} lang={lang} />
  <p class="story-desc">{post.data.description}</p>
</article>
