---
import Base from '../../layouts/Base.astro';
import { SITE, type Locale } from '../../lib/site';
import { gizlilikYolu } from '../../lib/yollar.mjs';

// Gizlilik sayfası; yollar: src/pages/tr/gizlilik.astro, src/pages/en/privacy.astro.
// Metin yalnız sitede gerçekte yapılanı anlatır (Cloudflare barındırma ve Web Analytics).
interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const ui = SITE.ui[lang];
const description =
  lang === 'tr'
    ? 'JEN DUME gizlilik bildirimi: sitenin hangi veriyi topladığı, hangi ölçümün yapıldığı ve nasıl iletişime geçileceği.'
    : 'JEN DUME privacy notice: what data the site collects, which analytics it uses, and how to contact us.';
---

<Base
  lang={lang}
  title={ui.privacy}
  description={description}
  canonicalPath={gizlilikYolu(lang)}
  langUrls={{ tr: gizlilikYolu('tr'), en: gizlilikYolu('en') }}
  alternates={{ tr: gizlilikYolu('tr'), en: gizlilikYolu('en'), 'x-default': gizlilikYolu('en') }}
>
  <article class="article">
    {
      lang === 'tr' ? (
        <div class="prose about">
          <header class="article-header">
            <h1 class="article-title">Gizlilik</h1>
          </header>
          <p>Bu sayfa JEN DUME'nin ziyaretçilerden hangi veriyi topladığını ve bunu nasıl yaptığını anlatır.</p>

          <h2>Ne topluyoruz?</h2>
          <p>
            JEN DUME'de üyelik, hesap ya da kişisel veri isteyen bir form yoktur. Sitede okuduklarınız için sizden ad,
            e-posta adresi ya da başka bir kişisel bilgi istemiyoruz ve saklamıyoruz.
          </p>

          <h2>Barındırma</h2>
          <p>Site Cloudflare üzerinden yayınlanır; sayfalar statik dosyalar olarak sunulur.</p>

          <h2>Site ölçümü</h2>
          <p>
            Site ziyaretleri için Cloudflare Web Analytics kullanılır. Bu ölçüm çerez kullanmaz ve sizi kişisel olarak
            tanımlamaz.
          </p>

          <h2>İletişim</h2>
          <p>
            Veri talepleri ve düzeltmeler için: <a href="mailto:contact@jendume.com">contact@jendume.com</a>
          </p>
        </div>
      ) : (
        <div class="prose about">
          <header class="article-header">
            <h1 class="article-title">Privacy</h1>
          </header>
          <p>This page explains what data JEN DUME collects from visitors and how it handles it.</p>

          <h2>What we collect</h2>
          <p>
            JEN DUME has no memberships, accounts or forms that ask for personal data. We do not ask for or keep your
            name, email address or any other personal information in order for you to read the site.
          </p>

          <h2>Hosting</h2>
          <p>The site is served through Cloudflare as static files.</p>

          <h2>Site analytics</h2>
          <p>
            We use Cloudflare Web Analytics to measure site visits. This measurement does not use cookies and does not
            identify you personally.
          </p>

          <h2>Contact</h2>
          <p>
            For data requests and corrections: <a href="mailto:contact@jendume.com">contact@jendume.com</a>
          </p>
        </div>
      )
    }
  </article>
</Base>
