---
// Site içi arama / Search; yollar: src/pages/tr/arama.astro, src/pages/en/search.astro.
// Sonuçlar tarayıcıda dilin dizininden (/tr/arama.json, /en/search.json) süzülür (bkz. src/lib/arama-cekirdek.mjs).
// Betik ayrı dosya olarak yüklenir (CSP satır içi betiğe izin vermez); sayfa arama motorlarına kapalıdır.
import Base from '../../layouts/Base.astro';
import { SITE, type Locale } from '../../lib/site';
import { aramaDiziniYolu, aramaYolu, konuDiziniYolu } from '../../lib/yollar.mjs';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const tr = lang === 'tr';
const T = tr
  ? {
      baslik: 'Haberlerde ara',
      aciklama: `${SITE.displayName} haberlerinde başlık, spot ve bölüme göre arama.`,
      etiket: 'Aranacak kelimeler',
      ornek: 'ör. OpenAI, çip, yapay zekâ yasası',
      dugme: 'Ara',
      noscript: 'Arama için tarayıcınızda JavaScript açık olmalı. Haberlere konu sayfalarından da ulaşabilirsiniz:',
      konular: 'Konular',
    }
  : {
      baslik: 'Search stories',
      aciklama: `Search ${SITE.displayName} stories by headline, summary and section.`,
      etiket: 'Search terms',
      ornek: 'e.g. OpenAI, chips, AI act',
      dugme: 'Search',
      noscript: 'Search needs JavaScript in your browser. You can also browse stories by topic:',
      konular: 'Topics',
    };
---

<Base lang={lang} title={T.baslik} description={T.aciklama} canonicalPath={aramaYolu(lang)} noindex
  langUrls={{ tr: aramaYolu('tr'), en: aramaYolu('en') }}
>
  <article class="article arama" data-dil={lang} data-dizin={aramaDiziniYolu(lang)}>
    <header class="article-header">
      <h1>{T.baslik}</h1>
    </header>
    <form class="arama-form" action={aramaYolu(lang)} method="get" role="search">
      <label for="arama-q">{T.etiket}</label>
      <div class="arama-satir">
        <input id="arama-q" name="q" type="search" autocomplete="off" spellcheck="false" placeholder={T.ornek} />
        <button type="submit">{T.dugme}</button>
      </div>
    </form>
    <p class="arama-durum" id="arama-durum" aria-live="polite"></p>
    <ol class="arama-sonuc" id="arama-sonuc"></ol>
    <noscript><p class="arama-durum">{T.noscript} <a href={konuDiziniYolu(lang)}>{T.konular}</a></p></noscript>
  </article>
</Base>

<script>
  import { ara } from '../../lib/arama-cekirdek.mjs';

  type Kayit = { t: string; d: string; k: string; u: string; z: string };

  const kok = document.querySelector('.arama') as HTMLElement;
  const tr = kok.dataset.dil === 'tr';
  const girdi = document.getElementById('arama-q') as HTMLInputElement;
  const durum = document.getElementById('arama-durum')!;
  const liste = document.getElementById('arama-sonuc')!;
  const tarih = (iso: string) =>
    new Date(iso).toLocaleDateString(tr ? 'tr-TR' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Istanbul' });
  const mesaj = (n: number, q: string) =>
    tr
      ? n
        ? `“${q}” için ${n === 50 ? 'en ilgili 50' : n} sonuç`
        : `“${q}” için sonuç bulunamadı. Daha kısa ya da farklı bir kelime deneyin.`
      : n
        ? `${n === 50 ? 'Top 50' : n} results for “${q}”`
        : `No results for “${q}”. Try a shorter or different word.`;

  let dizin: Kayit[] | undefined;
  async function dizinYukle() {
    if (!dizin) dizin = await fetch(kok.dataset.dizin!).then((r) => r.json());
    return dizin!;
  }

  function goster(sonuc: Kayit[], sorgu: string) {
    liste.replaceChildren(
      ...sonuc.map((k) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = k.u;
        a.textContent = k.t;
        const h = document.createElement('h2');
        h.append(a);
        const p = document.createElement('p');
        p.textContent = k.d;
        const meta = document.createElement('p');
        meta.className = 'arama-meta';
        meta.textContent = `${k.k} · ${tarih(k.z)}`;
        li.append(h, p, meta);
        return li;
      }),
    );
    durum.textContent = sorgu.trim() ? mesaj(sonuc.length, sorgu.trim()) : '';
  }

  async function calistir(sorgu: string) {
    const kayitlar = await dizinYukle();
    goster(sorgu.trim() ? ara(kayitlar, sorgu) : [], sorgu);
  }

  const ilk = new URLSearchParams(location.search).get('q') ?? '';
  girdi.value = ilk;
  if (ilk) calistir(ilk);

  let bekle: ReturnType<typeof setTimeout>;
  girdi.addEventListener('input', () => {
    clearTimeout(bekle);
    bekle = setTimeout(() => {
      const url = new URL(location.href);
      if (girdi.value.trim()) url.searchParams.set('q', girdi.value);
      else url.searchParams.delete('q');
      history.replaceState(null, '', url);
      calistir(girdi.value);
    }, 150);
  });
  girdi.closest('form')!.addEventListener('submit', (e) => {
    e.preventDefault();
    calistir(girdi.value);
  });
</script>

<style>
  .arama {
    max-width: 760px;
  }
  .arama-form label {
    display: block;
    margin-bottom: 6px;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .arama-satir {
    display: flex;
    gap: 8px;
  }
  .arama-satir input {
    flex: 1;
    min-width: 0;
    padding: 10px 12px;
    border: 2px solid var(--ink);
    border-radius: 0;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-size: 1.05rem;
  }
  .arama-satir button {
    padding: 10px 18px;
    border: 0;
    background: var(--signal);
    color: var(--ink);
    font-family: var(--font-sign);
    font-weight: 700;
    cursor: pointer;
  }
  .arama-durum {
    margin: 16px 0 8px;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .arama-sonuc {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .arama-sonuc :global(li) {
    padding: 14px 0;
    border-bottom: 1px solid var(--hair);
  }
  .arama-sonuc :global(h2) {
    margin: 0 0 4px;
    font-family: var(--font-sign);
    font-size: 1.15rem;
    line-height: 1.3;
  }
  .arama-sonuc :global(p) {
    margin: 0;
  }
  .arama-sonuc :global(.arama-meta) {
    margin-top: 4px;
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
