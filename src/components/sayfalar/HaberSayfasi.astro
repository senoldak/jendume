---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StoryCard from '../../components/StoryCard.astro';
import SignHeading from '../../components/SignHeading.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import YapayZekaNotu from '../../components/YapayZekaNotu.astro';
import AracSatiri from '../../components/haber/AracSatiri.astro';
import KisaOzet from '../../components/haber/KisaOzet.astro';
import NasilHazirlandi from '../../components/haber/NasilHazirlandi.astro';
import DahaOnce from '../../components/haber/DahaOnce.astro';
import DegisiklikKaydi from '../../components/haber/DegisiklikKaydi.astro';
import Yarar from '../../components/haber/Yarar.astro';
import YerHaritasi from '../../components/haber/YerHaritasi.astro';
import '../../styles/haber.css';
import '../../styles/piksel-font.css';
import { kapakAlt, KAPAK_G, KAPAK_Y } from '../../kapak/ciz';
import { SITE, formatDate, getCategory, otherLocale, readingMinutes, type Locale } from '../../lib/site';
import { abs, articleCrumbs, articleGraph } from '../../lib/seo';
import { dahaOnceHaberler, ilgiliHaberler } from '../../lib/ilgili';
import { haberKonulari, konuBul } from '../../lib/konular';
import { konuVerisi } from '../../lib/rotalar';
import { analizYolu, konuYolu, terimYolu, yazarYolu } from '../../lib/yollar.mjs';
import { dizinlenir } from '../../lib/kalite.mjs';
import { medyaKaynakli } from '../../lib/kaynak-satiri.mjs';
import { analizMi, kisiYazariMi } from '../../lib/yazi-turu.mjs';
import { adimlar } from '../../lib/ajanlar.mjs';
import { haritaUlkesi } from '../../lib/harita.mjs';
import { TERIMLER, terimGecisleri } from '../../lib/sozluk.mjs';
import { yapayZekaNotu } from '../../lib/yapayzeka-notu.mjs';
import { duzeltmeNotu } from '../../lib/duzeltme.mjs';
import {
  getPublishedPosts,
  getAvailableTranslations,
  getCategoryUrl,
  getPostUrl,
  kapakBilgisi,
  type NewsEntry,
} from '../../lib/news';

// Haber sayfası; yollar: src/pages/tr/haber/[id].astro, src/pages/en/news/[id].astro (bkz. src/lib/yollar.mjs).
interface Props {
  lang: Locale;
  post: NewsEntry;
}

const { lang, post } = Astro.props;
const id = post.id;
const { Content } = await render(post);

const other = otherLocale(lang);
const ui = SITE.ui[lang];
const duzeltme = duzeltmeNotu(post.data, lang);
const { available: translations, ids: esIds } = await getAvailableTranslations(lang, id);

const langUrls: Partial<Record<Locale, string>> = {
  tr: translations.tr ? getPostUrl('tr', esIds.tr) : '/tr/',
  en: translations.en ? getPostUrl('en', esIds.en) : '/en/',
};

// Gövdesi çok kısa haber erişilebilir kalır ama dizine girmez (src/lib/kalite.mjs); her dil kendi gövdesiyle ölçülür.
const indexable = dizinlenir(post.body);
const otherPost = translations[other] ? (await getPublishedPosts(other)).find((p) => p.id === esIds[other]) : undefined;
const otherIndexable = Boolean(otherPost && dizinlenir(otherPost.body));

// hreflang yalnız gerçekten var olan ve dizine giren çeviriler arasında; x-default İngilizce sürüm.
const alternates: Partial<Record<Locale | 'x-default', string>> = {};
if (translations.tr && translations.en && indexable && otherIndexable) {
  alternates.en = getPostUrl('en', esIds.en);
  alternates.tr = getPostUrl('tr', esIds.tr);
  alternates['x-default'] = getPostUrl('en', esIds.en);
}
// Her haberin 1200 px paylaşım görseli var: kendi kapağı ya da (bütçe dışındaki eskilerde) bölüm kapağı.
const cover = await kapakBilgisi(post, lang);
const catTitle = getCategory(post.data.category, lang).title;

// Daha önce bu konuda: önceki ve gerçekten ilişkili haberler. İlgili haberler: ortak varlık > aynı bölüm > en yeni;
// bülten, kısa (noindex) haber, kendisi ve "daha önce" listesindekiler hariç.
const hepsi = await getPublishedPosts(lang);
const onceki = dahaOnceHaberler(post, hepsi);
const related = ilgiliHaberler(post, hepsi.filter((p) => !onceki.includes(p)));
const crumbs = articleCrumbs(post, lang);

// Haberin konuları: yalnız bu dilde sayfası olan (en az 3 haberli) konular bağlanır.
const sayfaliKonular = await konuVerisi(lang);
const konular = haberKonulari(post).filter((s) => sayfaliKonular.has(s)).map((s) => konuBul(s)!);

const cat = getCategory(post.data.category, lang);
const adres = abs(getPostUrl(lang, id));
const not = yapayZekaNotu({ veri: post.data, dil: lang, baslik: post.data.title, adres });
// "Bu haber nasıl hazırlandı" kartı olan yazıda eski yapay zekâ notu gösterilmez (kart aynı şeyi söyler).
const kartVar = Boolean(adimlar(post.data));
const ulke = haritaUlkesi(post.data, lang);
// Sözlük kartı: metinde bağlanan terimlerin kısa tanımı (betik: src/scripts/haber-araclari.ts).
const terimIdleri = new Set(terimGecisleri(post.body ?? '', lang, { yalnizBaglanan: true }).map((g: { id: string }) => g.id));
const sozlukVeri = Object.fromEntries(
  TERIMLER.filter((t) => terimIdleri.has(t.id)).map((t) => [
    terimYolu(lang, t.id),
    { ad: t[lang].ad, ozet: t[lang].ozet, adres: terimYolu(lang, t.id), devam: lang === 'en' ? 'More in the glossary' : 'Sözlükte devamı' },
  ]),
);
const sozlukJson = JSON.stringify(sozlukVeri).replace(/</g, '\\u003c');
---

<Base
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  canonicalPath={getPostUrl(lang, id)}
  langUrls={langUrls}
  alternates={alternates}
  activeCategory={post.data.category}
  type="article"
  image={cover.url}
  imageAlt={cover.ozel ? kapakAlt(post, lang) : catTitle}
  imageWidth={KAPAK_G}
  imageHeight={KAPAK_Y}
  noindex={!indexable}
  author={kisiYazariMi(post.data) ? SITE.author.name : SITE.displayName}
  published={post.data.date}
  modified={post.data.updated ?? post.data.date}
  section={catTitle}
  schema={articleGraph(post, lang, cover.url)}
>
  <Breadcrumb lang={lang} items={crumbs} />
  <article class="article hn">
    <header class="article-header">
      <p class="hn-kicker">
        <a href={getCategoryUrl(lang, cat.slug)}>{cat.title}</a>
        <span class="oteki" lang={other}>{getCategory(post.data.category, other).title}</span>
        {post.data.breaking && <span class="etiket">{ui.breakingBadge}</span>}
        {analizMi(post.data) && <a href={analizYolu(lang)}>{lang === 'tr' ? 'Analiz' : 'Analysis'}</a>}
      </p>
      <h1 class="article-title">{post.data.title}</h1>
      <p class="article-deck">{post.data.description}</p>
      <div class="hn-meta">
        <span>
          {ui.byline}{' '}
          {kisiYazariMi(post.data) ? (
            <><a href={yazarYolu(lang)} rel="author">{SITE.author.name}</a>, {SITE.author.title[lang]}</>
          ) : (
            <><b>{SITE.displayName}</b> {kartVar && <span class="yz">{lang === 'en' ? 'AI' : 'YZ'}</span>}</>
          )}
        </span>
        <span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time></span>
        <span>{readingMinutes(post.body ?? post.data.description)} {ui.minRead}</span>
        {post.data.bolge && <span>{post.data.bolge}</span>}
      </div>
      <AracSatiri
        lang={lang}
        baslik={post.data.title}
        adres={adres}
        otekiAdres={translations[other] ? getPostUrl(other, esIds[other]) : undefined}
      />
      <KisaOzet
        lang={lang}
        neden={post.data.why_matters || post.data.perspektif}
        maddeler={post.data.key_points}
        rakamlar={post.data.rakamlar}
      />
    </header>

    {
      cover.ozel && (
        <figure class="article-cover">
          <img src={cover.url} alt={kapakAlt(post, lang)} width={KAPAK_G} height={KAPAK_Y} loading="eager" fetchpriority="high" decoding="async" />
        </figure>
      )
    }

    {ulke && <YerHaritasi lang={lang} ulke={ulke} />}

    <div class="prose">
      <Content />
    </div>
    {Object.keys(sozlukVeri).length > 0 && <script type="application/json" id="sozluk-veri" set:html={sozlukJson} />}

    {
      post.data.kaynaklar.length > 0 && (
        <p class="ai-note official-source">
          {lang === 'en'
            ? post.data.kaynaklar.length > 1 ? 'Official sources:' : 'Official source:'
            : post.data.kaynaklar.length > 1 ? 'Resmî kaynaklar:' : 'Resmî kaynak:'}{' '}
          {post.data.kaynaklar.map((k, i) => (
            <>
              {i > 0 && ', '}
              <a href={k.url} rel="noopener">{k.ad}</a>
            </>
          ))}
        </p>
      )
    }

    {
      medyaKaynakli(post.data) && (
        <p class="ai-note official-source">{ui.mediaSource}</p>
      )
    }

    {
      analizMi(post.data) && post.data.category === 'ekonomi' && (
        <p class="ai-note">{lang === 'tr' ? 'Bu analiz yatırım tavsiyesi değildir.' : 'This analysis is not investment advice.'}</p>
      )
    }

    {kartVar ? (
      <NasilHazirlandi lang={lang} veri={post.data} yayin={post.data.date} guncelleme={post.data.updated} mailto={not.mailto} />
    ) : (
      <YapayZekaNotu lang={lang} veri={post.data} baslik={post.data.title} adres={adres} />
    )}

    <DahaOnce lang={lang} haberler={onceki} />

    <DegisiklikKaydi lang={lang} yayin={post.data.date} guncelleme={post.data.updated} duzeltme={duzeltme} />

    <Yarar lang={lang} kimlik={`${lang}/${id}`} />

    {
      konular.length > 0 && (
        <nav class="story-topics" aria-labelledby="story-topics-heading">
          <h2 class="term-related-heading" id="story-topics-heading">{ui.topicsInStory}</h2>
          <ul class="tag-list">
            {konular.map((k) => (
              <li>
                <a class="tag" href={konuYolu(lang, k.slug)}>{k.ad}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </article>
  <script>
    import '../../scripts/haber-araclari.ts';
  </script>

  {
    related.length > 0 && (
      <section class="block" aria-labelledby="related-heading">
        <SignHeading lang={lang} label="relatedStories" id="related-heading" />
        <div class="story-grid">
          {related.map((rel) => (
            <StoryCard post={rel} lang={lang} />
          ))}
        </div>
      </section>
    )
  }
</Base>
