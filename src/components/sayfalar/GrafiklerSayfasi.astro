---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import JendumeChartCard from '../kartlar/JendumeChartCard.astro';
import RakamSeridi from '../RakamSeridi.astro';
import SentezBlok from '../SentezBlok.astro';
import { SITE, type Locale } from '../../lib/site';
import { abs, type Crumb } from '../../lib/seo';
import { JENDUME_GRAFİKLER } from '../../lib/jendume-charts-data';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const path = lang === 'tr' ? '/tr/grafikler/' : '/en/charts/';
const url = abs(path);

const metin = {
  tr: {
    baslik: 'Yapay Zekâ ve Teknoloji Veri Kataloğu — 62 Grafik & Temel Sistem',
    katalogBaslik: 'Yapay Zekâ ve Teknoloji Veri Kataloğu',
    aciklama:
      'Dil modelleri, GPU donanımı, AB Yapay Zekâ Tüzüğü, veri merkezi enerjisi ve açık kaynak ekosistemine dair editoryal veri blokları ve 62 interaktif grafik kartı.',
    rozet: 'AÇIK VERİ & ANALİTİK',
    aramaPlaceholder: 'Grafik, metrik veya kaynak ara...',
    tumKategoriler: 'TÜMÜ',
    toplamMetin: 'Toplam 62 analitik göstergesi',
    gosterilenMetin: 'gösteriliyor',
    bolum1Baslik: '1. Temel Veri Blokları & Sentez Levhaları',
    bolum1Ozet: 'Haber başlarında ve editoryal analizlerde kullanılan kilit rakam şeritleri ve özet levhaları.',
    bolum2Baslik: '2. Editoryal Veri Seçim Matrisi',
    bolum2Ozet: 'Hangi içerik türünde hangi veri bileşeninin tercih edilmesi gerektiğine dair rehber.',
    bolum3Baslik: '3. 62 İnteraktif Gösterge Kartı',
    bolum3Ozet: 'Kategori ve arama filtrelerine sahip 62 yapay zekâ ve teknoloji göstergesi.',
    kategoriler: [
      'TÜMÜ',
      'DİL MODELLERİ & LLM',
      'YAPAY ZEKÂ ÇİPLERİ & DONANIM',
      'AB MEVZUATI & AI ACT',
      'VERİ MERKEZİ & ENERJİ',
      'YAPAY ZEKÂ YATIRIMLARI',
      'AÇIK KAYNAK EKOSİSTEMİ',
    ],
  },
  en: {
    baslik: 'AI & Technology Data Catalog — 62 Charts & Core Systems',
    katalogBaslik: 'AI & Technology Data Catalog',
    aciklama:
      '62 interactive chart cards and editorial quantitative blocks covering LLMs, GPU hardware, EU AI Act compliance, datacenter energy, and open-source ecosystems.',
    rozet: 'OPEN DATA & ANALYTICS',
    aramaPlaceholder: 'Search charts, metrics, or sources...',
    tumKategoriler: 'ALL',
    toplamMetin: 'Total 62 analytical indicators',
    gosterilenMetin: 'showing',
    bolum1Baslik: '1. Core Quantitative Blocks & Synthesis Cards',
    bolum1Ozet: 'Key metric strips and executive synthesis boards used across editorial briefs and analytical articles.',
    bolum2Baslik: '2. Editorial Component Selection Matrix',
    bolum2Ozet: 'Guidelines on which data presentation format to choose for each editorial reporting scenario.',
    bolum3Baslik: '3. 62 Interactive Indicator Cards',
    bolum3Ozet: '62 AI and technology metrics with instant search and categorical filtering.',
    kategoriler: [
      'ALL',
      'LANGUAGE MODELS & LLM',
      'AI CHIPS & HARDWARE',
      'EU REGULATION & AI ACT',
      'DATA CENTERS & ENERGY',
      'AI VENTURE & INVESTMENTS',
      'OPEN SOURCE ECOSYSTEM',
    ],
  },
}[lang];

const crumbs: Crumb[] = [
  { name: SITE.displayName, path: `/${lang}/` },
  { name: lang === 'tr' ? 'Grafikler' : 'Charts', path },
];

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${url}#page`,
    url,
    name: metin.baslik,
    description: metin.aciklama,
    inLanguage: lang,
    isPartOf: { '@id': abs('/#website') },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: JENDUME_GRAFİKLER.length,
      itemListElement: JENDUME_GRAFİKLER.slice(0, 30).map((g, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: lang === 'tr' ? g.baslikTr : g.baslikEn,
        description: lang === 'tr' ? g.aciklamaTr : g.aciklamaEn,
      })),
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: abs(c.path) })),
  },
];

const normalle = (str: string) =>
  str
    .toLowerCase()
    .replace(/ğ/g, 'g')
    .replace(/ü/g, 'u')
    .replace(/ş/g, 's')
    .replace(/ı/g, 'i')
    .replace(/ö/g, 'o')
    .replace(/ç/g, 'c');

// Örnek Rakam Şeridi Verisi
const ornekRakamlar = lang === 'tr' ? [
  { etiket: 'Aktif LLM Modelleri', deger: '12.450+' },
  { etiket: 'Yıllık Yatırım Hacmi', deger: '$84,2 Milyar' },
  { etiket: 'Açık Kaynak Payı', deger: '%68,4' },
  { etiket: 'AB Uyum Skoru', deger: '94 / 100' },
] : [
  { etiket: 'Active LLM Models', deger: '12,450+' },
  { etiket: 'Annual Venture Capital', deger: '$84.2 Billion' },
  { etiket: 'Open-Weight Share', deger: '68.4%' },
  { etiket: 'EU AI Act Score', deger: '94 / 100' },
];

// Örnek Sentez Bloğu Metni
const ornekWhy = lang === 'tr'
  ? 'Yapay zekâ ve işlemci göstergeleri, hesaplama maliyetleri ve AB regülasyon baskısı altında teknoloji sektörünün rotasını belirleyen somut sinyallerdir.'
  : 'AI compute and hardware indicators serve as verifiable market signals defining industry trajectory amidst energy constraints and EU compliance.';

const ornekPoints = lang === 'tr'
  ? [
      'Geliştirici ekosisteminde açık kaynak modellerin payı son bir yılda %68 seviyesini aşmıştır.',
      'Veri merkezi enerji tüketimi Avrupa genelinde kritik şebeke sınırlarına yaklaşmaktadır.',
      'Yüksek riskli yapay zekâ sistemlerinde şeffaflık ve denetlenebilirlik şartı zorunlu hale gelmiştir.'
    ]
  : [
      'Open-weight models now account for more than 68% of new developer deployments.',
      'Datacenter power demand is approaching critical grid capacity limits across European hubs.',
      'Mandatory algorithmic transparency is now enforceable under the EU AI Act compliance framework.'
    ];
---

<Base
  lang={lang}
  title={metin.baslik}
  description={metin.aciklama}
  canonicalPath={path}
  langUrls={{ tr: '/tr/grafikler/', en: '/en/charts/' }}
  alternates={{ tr: '/tr/grafikler/', en: '/en/charts/', 'x-default': '/en/charts/' }}
  schema={schema}
>
  <div class="katalog-kapsayici">
    <Breadcrumb lang={lang} items={crumbs} />

    <header class="sayfa-baslik-alani">
      <div class="ust-etiket">
        <span class="levha-nokta" aria-hidden="true"></span>
        <span>{metin.rozet}</span>
      </div>
      <h1>{metin.katalogBaslik}</h1>
      <p class="sayfa-ozet">{metin.aciklama}</p>
    </header>

    <!-- Hızlı Gezinti -->
    <nav class="hizli-atlama" aria-label="Bölüm seçici">
      <span class="atlama-etiket">{lang === 'tr' ? 'Bölümler:' : 'Sections:'}</span>
      <a href="#temel-bloklar" class="atlama-link">{metin.bolum1Baslik}</a>
      <a href="#secim-matrisi" class="atlama-link">{metin.bolum2Baslik}</a>
      <a href="#kart-katalogu" class="atlama-link">{metin.bolum3Baslik}</a>
    </nav>

    <!-- BÖLÜM 1: TEMEL VERİ BLOKLARI -->
    <section id="temel-bloklar" class="temel-bloklar-alani">
      <div class="bolum-baslik-blok">
        <span class="bolum-no">01</span>
        <div>
          <h2 class="bolum-ana-baslik">{metin.bolum1Baslik}</h2>
          <p class="bolum-alt-metin">{metin.bolum1Ozet}</p>
        </div>
      </div>

      <!-- Örnek 1: Rakam Şeridi -->
      <article class="blok-vitrin-karti">
        <div class="blok-karti-ust">
          <div>
            <span class="blok-tur-etiketi">METRİK ŞERİDİ &middot; RAKAMSERİDİ.ASTRO</span>
            <h3 class="blok-baslik">{lang === 'tr' ? 'Kilit Metrik Şeridi' : 'Key Quantitative Metric Strip'}</h3>
            <p class="blok-aciklama">
              {lang === 'tr' 
                ? 'Haberlerin ve bültenlerin başında en fazla 4 kritik sayıyı okuyucuya doğrudan sunan tipografik veri levhası.'
                : 'Top-of-article metric banner presenting up to four verified quantitative values before narrative prose.'}
            </p>
          </div>
          <div class="blok-kod-tag"><code>&lt;RakamSeridi /&gt;</code></div>
        </div>
        <div class="blok-onizleme">
          <RakamSeridi lang={lang} rakamlar={ornekRakamlar} />
        </div>
      </article>

      <!-- Örnek 2: Sentez Bloğu -->
      <article class="blok-vitrin-karti">
        <div class="blok-karti-ust">
          <div>
            <span class="blok-tur-etiketi">EDİTORYAL SENTEZ &middot; SENTEZBLOK.ASTRO</span>
            <h3 class="blok-baslik">{lang === 'tr' ? 'Sentez ve Çıkarım Bloğu' : 'Editorial Synthesis Board'}</h3>
            <p class="blok-aciklama">
              {lang === 'tr'
                ? '"Neden Önemli?" perspektifini ve 3 maddelik ana çıkarımları içeren iki dilli analitik kart.'
                : 'Bilingual analytical board featuring "Why It Matters" context and 3 key takeaways for executive briefs.'}
            </p>
          </div>
          <div class="blok-kod-tag"><code>&lt;SentezBlok /&gt;</code></div>
        </div>
        <div class="blok-onizleme">
          <SentezBlok
            lang={lang}
            whyMatters={ornekWhy}
            keyPoints={ornekPoints}
          />
        </div>
      </article>
    </section>

    <!-- BÖLÜM 2: SEÇİM MATRİSİ -->
    <section id="secim-matrisi" class="matris-alani">
      <div class="bolum-baslik-blok">
        <span class="bolum-no">02</span>
        <div>
          <h2 class="bolum-ana-baslik">{metin.bolum2Baslik}</h2>
          <p class="bolum-alt-metin">{metin.bolum2Ozet}</p>
        </div>
      </div>

      <div class="matris-tablo-sarmal">
        <table class="matris-tablo">
          <thead>
            <tr>
              <th>{lang === 'tr' ? 'Bileşen' : 'Component'}</th>
              <th>{lang === 'tr' ? 'Şablon Kodu' : 'Template Code'}</th>
              <th>{lang === 'tr' ? 'İdeal Kullanım Alanı' : 'Best Editorial Fit'}</th>
              <th>{lang === 'tr' ? 'Öne Çıkan Nitelik' : 'Key Characteristic'}</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>{lang === 'tr' ? 'Kilit Rakam Şeridi' : 'Key Metric Strip'}</strong></td>
              <td><code>&lt;RakamSeridi /&gt;</code></td>
              <td>{lang === 'tr' ? 'Haber ve analiz başları, özet paneller' : 'Article intros, news leads, quick summaries'}</td>
              <td>{lang === 'tr' ? '4 doğrulanmış rakam, 0px kılavuz çizgileri' : 'Up to 4 verified values, clean hairline layout'}</td>
            </tr>
            <tr>
              <td><strong>{lang === 'tr' ? 'Sentez Bloğu' : 'Synthesis Board'}</strong></td>
              <td><code>&lt;SentezBlok /&gt;</code></td>
              <td>{lang === 'tr' ? 'Editoryal köşe, derinlemesine teknoloji analizi' : 'Deep-dive analytical essays, policy briefs'}</td>
              <td>{lang === 'tr' ? 'Neden Önemli? ve 3 maddelik sentez dökümü' : 'Why It Matters perspective and 3 bullet synthesis'}</td>
            </tr>
            <tr>
              <td><strong>{lang === 'tr' ? 'Gösterge Kartları (62 adet)' : 'Indicator Cards (62 items)'}</strong></td>
              <td><code>&lt;JendumeChartCard /&gt;</code></td>
              <td>{lang === 'tr' ? 'Veri kataloğu, metin içi grafik gömmeleri' : 'Data catalog, in-text chart embeds, topic hubs'}</td>
              <td>{lang === 'tr' ? 'Saf SVG: Halka, Şelale, Alan, Çubuk, Radar' : 'Pure SVG: Donut, Waterfall, Area, Bar, Radar'}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- BÖLÜM 3: 62 KARTLIK KATALOG -->
    <section id="kart-katalogu" class="kart-katalogu-alani">
      <div class="bolum-baslik-blok">
        <span class="bolum-no">03</span>
        <div>
          <h2 class="bolum-ana-baslik">{metin.bolum3Baslik}</h2>
          <p class="bolum-alt-metin">{metin.bolum3Ozet}</p>
        </div>
      </div>

      <!-- Filtre Paneli -->
      <div class="filtre-paneli">
        <div class="kategori-butonlari" role="tablist" aria-label={lang === 'tr' ? 'Kategori filtresi' : 'Category filter'}>
          {
            metin.kategoriler.map((kat, i) => (
              <button
                type="button"
                class={`kategori-sekme ${i === 0 ? 'aktif' : ''}`}
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                data-kategori={kat}
              >
                {kat}
              </button>
            ))
          }
        </div>

        <div class="arama-kutusu-sarmal">
          <label for="grafik-arama" class="sr-only">{lang === 'tr' ? 'Grafik Ara' : 'Search Charts'}</label>
          <input
            type="search"
            id="grafik-arama"
            placeholder={metin.aramaPlaceholder}
            class="arama-girdisi"
            autocomplete="off"
          />
        </div>
      </div>

      <!-- Grafik Sayacı -->
      <div class="sonuc-bilgisi">
        <span>{metin.toplamMetin}</span>
        <span id="gorunen-sayac" class="gorunen-adet">62 {metin.gosterilenMetin}</span>
      </div>

      <!-- 62 Kartlık Izgara -->
      <div class="grafikler-izgara" id="grafikler-izgara">
        {
          JENDUME_GRAFİKLER.map((grafik) => {
            const aramaMetni = normalle(
              `${grafik.baslikTr} ${grafik.baslikEn} ${grafik.aciklamaTr} ${grafik.aciklamaEn} ${grafik.kategoriTr} ${grafik.kategoriEn} ${grafik.kaynakTr} ${grafik.kaynakEn} ${grafik.id}`
            );
            return (
              <div
                class="grafik-karti-sarmal"
                data-kategori-tr={grafik.kategoriTr}
                data-kategori-en={grafik.kategoriEn}
                data-tur={grafik.tur}
                data-arama={aramaMetni}
              >
                <JendumeChartCard grafik={grafik} lang={lang} />
              </div>
            );
          })
        }
      </div>
    </section>
  </div>
</Base>

<script>
  const aramaInput = document.getElementById('grafik-arama') as HTMLInputElement | null;
  const kategoriButonlari = document.querySelectorAll<HTMLButtonElement>('.kategori-sekme');
  const kartlar = document.querySelectorAll<HTMLElement>('.grafik-karti-sarmal');
  const gorunenSayac = document.getElementById('gorunen-sayac');

  let aktifKategori = '';
  let aramaMetni = '';

  const normalle = (str: string) =>
    str
      .toLowerCase()
      .replace(/ğ/g, 'g')
      .replace(/ü/g, 'u')
      .replace(/ş/g, 's')
      .replace(/ı/g, 'i')
      .replace(/ö/g, 'o')
      .replace(/ç/g, 'c');

  function filtrele() {
    let sayac = 0;
    kartlar.forEach((kart) => {
      const katTr = kart.dataset.kategoriTr ?? '';
      const katEn = kart.dataset.kategoriEn ?? '';
      const arama = kart.dataset.arama ?? '';

      const kategoriUyumu =
        !aktifKategori ||
        aktifKategori === 'TÜMÜ' ||
        aktifKategori === 'ALL' ||
        katTr.toLowerCase() === aktifKategori.toLowerCase() ||
        katEn.toLowerCase() === aktifKategori.toLowerCase();

      const aramaUyumu = !aramaMetni || arama.includes(aramaMetni);

      if (kategoriUyumu && aramaUyumu) {
        kart.style.display = '';
        sayac++;
      } else {
        kart.style.display = 'none';
      }
    });

    if (gorunenSayac) {
      gorunenSayac.textContent = `${sayac} / 62`;
    }
  }

  kategoriButonlari.forEach((btn) => {
    btn.addEventListener('click', () => {
      kategoriButonlari.forEach((b) => {
        b.classList.remove('aktif');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('aktif');
      btn.setAttribute('aria-selected', 'true');
      aktifKategori = btn.dataset.kategori ?? '';
      filtrele();
    });
  });

  if (aramaInput) {
    aramaInput.addEventListener('input', (e) => {
      aramaMetni = normalle((e.target as HTMLInputElement).value.trim());
      filtrele();
    });
  }
</script>

<style>
  .katalog-kapsayici {
    max-width: var(--container, 1320px);
    margin: 0 auto;
    padding: clamp(1rem, 3vw, 2.5rem) var(--gutter, 1.5rem);
    font-family: var(--font-read, 'Instrument Sans', sans-serif);
  }

  .sayfa-baslik-alani {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 2px solid var(--hair, #c9ccc4);
  }

  .ust-etiket {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--yesil-yazi, #00783d);
    background: #e6f7ee;
    padding: 0.25rem 0.625rem;
    border-radius: 3px;
    margin-bottom: 0.875rem;
  }

  .levha-nokta {
    width: 6px;
    height: 6px;
    background: var(--yesil, #00924a);
    display: inline-block;
  }

  .sayfa-baslik-alani h1 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    color: var(--ink, #16181d);
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 0.75rem 0;
  }

  .sayfa-ozet {
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--muted, #5a606b);
    max-width: 75ch;
    margin: 0;
  }

  /* Hızlı Atlama */
  .hizli-atlama {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    padding: 12px 16px;
    background: var(--ground, #f4f5f2);
    border: 1px solid var(--hair, #c9ccc4);
    margin-bottom: 2.5rem;
    font-size: 0.85rem;
  }

  .atlama-etiket {
    font-weight: 700;
    color: var(--ink, #16181d);
  }

  .atlama-link {
    color: var(--yesil-yazi, #00783d);
    text-decoration: underline;
    font-weight: 600;
  }

  /* Bölüm Başlıkları */
  .bolum-baslik-blok {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--hair, #c9ccc4);
  }

  .bolum-no {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--yesil, #00924a);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .bolum-ana-baslik {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--ink, #16181d);
    margin: 0 0 4px 0;
  }

  .bolum-alt-metin {
    font-size: 0.9rem;
    color: var(--muted, #5a606b);
    margin: 0;
  }

  /* Bölüm 1: Temel Bloklar */
  .temel-bloklar-alani {
    margin-bottom: 3.5rem;
  }

  .blok-vitrin-karti {
    background: #ffffff;
    border: 1px solid var(--hair, #c9ccc4);
    padding: 24px;
    margin-bottom: 24px;
    border-radius: 4px;
  }

  .blok-karti-ust {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--hair, #c9ccc4);
  }

  .blok-tur-etiketi {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--yesil-yazi, #00783d);
    display: block;
    margin-bottom: 4px;
  }

  .blok-baslik {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--ink, #16181d);
    margin: 0 0 6px 0;
  }

  .blok-aciklama {
    font-size: 0.9rem;
    color: var(--muted, #5a606b);
    line-height: 1.5;
    margin: 0;
    max-width: 760px;
  }

  .blok-kod-tag code {
    background: var(--ground, #f4f5f2);
    border: 1px solid var(--hair, #c9ccc4);
    padding: 6px 10px;
    font-size: 0.82rem;
    font-family: var(--font-mono, monospace);
    color: var(--ink, #16181d);
    white-space: nowrap;
    border-radius: 3px;
  }

  .blok-onizleme {
    background: var(--ground, #f4f5f2);
    padding: 16px;
    border: 1px solid var(--hair, #c9ccc4);
    border-radius: 4px;
  }

  /* Bölüm 2: Matris */
  .matris-alani {
    margin-bottom: 3.5rem;
  }

  .matris-tablo-sarmal {
    overflow-x: auto;
    border: 1px solid var(--hair, #c9ccc4);
    background: #ffffff;
    border-radius: 4px;
  }

  .matris-tablo {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    text-align: left;
  }

  .matris-tablo th {
    background: var(--ground, #f4f5f2);
    padding: 10px 14px;
    font-weight: 700;
    color: var(--ink, #16181d);
    border-bottom: 1px solid var(--hair, #c9ccc4);
  }

  .matris-tablo td {
    padding: 12px 14px;
    border-bottom: 1px solid var(--hair, #c9ccc4);
    color: var(--ink-2, #3a3f48);
