---
// "Bu haber işinize yaradı mı?": anonim günlük sayaç (worker/index.js → D1 jendume-yarar). IP, çerez ya da okur bilgisi
// tutulmaz; yalnız gün + haber + evet/hayır sayısı. Betik: src/scripts/haber-araclari.ts.
import type { Locale } from '../../lib/site';

interface Props {
  lang: Locale;
  kimlik: string;
}
const { lang, kimlik } = Astro.props;
// D1 veritabanı jendume-yarar (wrangler.jsonc) bağlı; kapatmak gerekirse false yapılır: sayılmayan oya "teşekkürler" denmez.
const YARAR_ACIK = true;
const t = (tr: string, en: string) => (lang === 'en' ? en : tr);
---

{
  YARAR_ACIK && (
    <div class="hn-yarar" role="group" aria-labelledby="yarar-soru" data-yarar-kimlik={kimlik}>
      <p id="yarar-soru">{t('Bu haber işinize yaradı mı?', 'Was this story useful?')}</p>
      <button type="button" data-yarar="evet">{t('Evet', 'Yes')}</button>
      <button type="button" data-yarar="hayir">{t('Hayır', 'No')}</button>
      <output hidden>{t('Teşekkürler. Yalnız günlük toplamı sayıyoruz; sizi tanıtan hiçbir bilgi kaydedilmiyor.', 'Thanks. We only count a daily total and store nothing that identifies you.')}</output>
    </div>
  )
}
