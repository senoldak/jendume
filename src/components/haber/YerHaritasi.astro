---
// Yer haritası: yalnız yer haberin konusuysa (src/lib/harita.mjs haritaUlkesi). Derlemede çizilen statik SVG.
import { haritaSvg } from '../../lib/harita.mjs';
import type { Locale } from '../../lib/site';

interface Props {
  lang: Locale;
  ulke: { id: string; ad: string };
}
const { lang, ulke } = Astro.props;
const svg = haritaSvg(ulke.id, lang === 'en' ? `Map showing ${ulke.ad}` : `Haritada ${ulke.ad}`);
---

{
  svg && (
    <figure class="hn-harita">
      <Fragment set:html={svg} />
      <figcaption><b>{ulke.ad}</b></figcaption>
    </figure>
  )
}
