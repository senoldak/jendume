---
import type { GetStaticPaths, Page } from 'astro';
import KonuSayfasi from '../../../../components/sayfalar/KonuSayfasi.astro';
import { konuYollari } from '../../../../lib/rotalar';
import type { NewsEntry } from '../../../../lib/news';

export const getStaticPaths = (({ paginate }) => konuYollari('en', paginate)) satisfies GetStaticPaths;

const { page, slug, otherCount } = Astro.props as { page: Page<NewsEntry>; slug: string; otherCount: number };
---

<KonuSayfasi lang="en" slug={slug} page={page} otherCount={otherCount} />
